{{ 'wardrobe-base.css' | asset_url | stylesheet_tag }}

<style>
  .wardrobe-story {
    background-color: #F5F0E8;
    padding: 0;
  }
  .wardrobe-story__container {
    max-width: 1400px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    min-height: 600px;
  }
  .wardrobe-story__image-wrapper {
    width: 100%;
    height: 100%;
    min-height: 560px;
    overflow: hidden;
  }
  .wardrobe-story__store-photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.6s ease;
  }
  .wardrobe-story__image:hover .wardrobe-story__store-photo {
    transform: scale(1.02);
  }
  .wardrobe-story__image-placeholder {
    width: 100%;
    height: 100%;
    min-height: 560px;
    background-color: #1A1A1A;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .wardrobe-story__placeholder-text {
    font-family: 'Cormorant Garamond', serif;
    font-size: 28px;
    font-weight: 300;
    letter-spacing: 0.3em;
    color: #B8965A;
    text-transform: uppercase;
  }
  .wardrobe-story__content {
    padding: 80px 72px;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  .wardrobe-story__label-wrapper {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-bottom: 28px;
  }
  .wardrobe-story__line {
    width: 32px;
    height: 1px;
    background-color: #B8965A;
    flex-shrink: 0;
  }
  .wardrobe-story__label {
    font-family: 'Inter', -apple-system, sans-serif;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #B8965A;
  }
  .wardrobe-story__title {
    font-family: 'Cormorant Garamond', Georgia, serif !important;
    font-size: clamp(32px, 3.5vw, 48px);
    font-weight: 300;
    line-height: 1.15;
    color: #1A1A1A;
    margin: 0 0 28px;
  }
  .wardrobe-story__text {
    font-family: 'Inter', -apple-system, sans-serif;
    font-size: 15px;
    line-height: 1.75;
    color: #6B6560;
    margin-bottom: 40px;
  }
  .wardrobe-story__text p { margin: 0 0 16px; }
  .wardrobe-story__text p:last-child { margin-bottom: 0; }
  @media (max-width: 1024px) {
    .wardrobe-story { display: block !important; visibility: visible !important; }
    .wardrobe-story__container { 
      display: grid !important;
      grid-template-columns: 1fr; 
      min-height: auto; 
      visibility: visible !important;
    }
    .wardrobe-story__image { display: block !important; }
    .wardrobe-story__content { display: flex !important; }
    .wardrobe-story__image-wrapper { min-height: 240px; }
    .wardrobe-story__image-placeholder { min-height: 240px; }
    .wardrobe-story__placeholder-text { 
      font-size: 18px; 
      letter-spacing: 0.12em;
      padding: 0 16px;
      text-align: center;
      word-break: break-word;
    }
    .wardrobe-story__content { padding: 32px 20px 40px; }
    .wardrobe-story__label-wrapper { margin-bottom: 20px; }
    .wardrobe-story__line { width: 24px; }
    .wardrobe-story__label { font-size: 10px; letter-spacing: 0.14em; }
    .wardrobe-story__title { 
      font-size: 26px; 
      line-height: 1.2;
      margin-bottom: 20px;
      word-break: break-word;
    }
    .wardrobe-story__text { 
      font-size: 14px; 
      line-height: 1.6;
      margin-bottom: 28px;
    }
    .wardrobe-story__text p { margin-bottom: 12px; }
    .wardrobe-story .wardrobe-button { 
      width: 100%; 
      justify-content: center;
      padding: 14px 20px;
      font-size: 11px;
    }
  }
</style>

<div class="wardrobe-story" id="wardrobe-story">
  <div class="wardrobe-story__container">
    <div class="wardrobe-story__image">
      <div class="wardrobe-story__image-wrapper">
        {%- if section.settings.store_image != blank -%}
          <img
            src="{{ section.settings.store_image | image_url: width: 800 }}"
            alt="{{ section.settings.store_image.alt | default: 'The Wardrobe Shillong Store' }}"
            class="wardrobe-story__store-photo"
            loading="lazy"
            width="800"
          >
        {%- else -%}
          <div class="wardrobe-story__image-placeholder">
            <span class="wardrobe-story__placeholder-text">THE WARDROBE</span>
          </div>
        {%- endif -%}
      </div>
    </div>
    <div class="wardrobe-story__content">
      <div class="wardrobe-story__label-wrapper">
        <span class="wardrobe-story__line"></span>
        <span class="wardrobe-story__label">OUR STORY</span>
      </div>
      <h2 class="wardrobe-story__title">{{ section.settings.title }}</h2>
      <div class="wardrobe-story__text">
        {%- if section.settings.body != blank -%}
          {{ section.settings.body }}
        {%- else -%}
          <p>The Wardrobe was born from a simple belief — that the hills of Meghalaya deserve access to the same quality and curation found in India's fashion capitals. We source from the best — global brands, independent labels, and timeless classics.</p>
          <p>From Police Bazar to your door. Every piece in our collection is hand-selected for quality, fit, and longevity. We believe fashion should be an investment, not just a purchase.</p>
        {%- endif -%}
      </div>
      <a href="{{ section.settings.cta_link | default: '/pages/about' }}" class="wardrobe-button wardrobe-button--ghost">
        {{ section.settings.cta_text | default: 'DISCOVER MORE' }} →
      </a>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Story Section",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "store_image",
      "label": "Store Photo"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Curating Shillong's Finest Since Day One"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body Text"
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "Button Text",
      "default": "DISCOVER MORE"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "Story Section",
      "category": "Wardrobe"
    }
  ]
}
{% endschema %}
