{{ 'wardrobe-base.css' | asset_url | stylesheet_tag }}

<div class="wardrobe-hero" id="wardrobe-hero">
  <div class="wardrobe-hero__container">
    <!-- Eyebrow -->
    <div class="wardrobe-hero__eyebrow">
      {{ section.settings.eyebrow_text }}
    </div>
    
    <!-- Main Headline -->
    <div class="wardrobe-hero__headline">
      <h1 class="wardrobe-hero__title">
        <span class="wardrobe-hero__title-main">{{ section.settings.title_main }}</span>
        <span class="wardrobe-hero__title-accent">{{ section.settings.title_accent }}</span>
      </h1>
      <div class="wardrobe-hero__subtitle">
        {{ section.settings.subtitle }}
      </div>
    </div>
    
    <!-- CTA Buttons -->
    <div class="wardrobe-hero__ctas">
      <a href="{{ section.settings.primary_cta_link }}" class="wardrobe-button wardrobe-button--primary">
        {{ section.settings.primary_cta_text }}
      </a>
      <a href="{{ section.settings.secondary_cta_link }}" class="wardrobe-button wardrobe-button--ghost">
        {{ section.settings.secondary_cta_text }}
      </a>
    </div>
  </div>
</div>

<!-- Thin divider -->
<div class="wardrobe-hero__divider"></div>

{% schema %}
{
  "name": "Wardrobe Hero",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow_text",
      "label": "Eyebrow Text",
      "default": "POLICE BAZAR, SHILLONG · EST. 2023"
    },
    {
      "type": "text",
      "id": "title_main",
      "label": "Title Main Text",
      "default": "Selected"
    },
    {
      "type": "text",
      "id": "title_accent",
      "label": "Title Accent Text",
      "default": "Acquisitions."
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "POLICE BAZAR, SHILLONG — CURATED RESELLER"
    },
    {
      "type": "url",
      "id": "primary_cta_link",
      "label": "Primary CTA Link",
      "default": "/collections/sneakers"
    },
    {
      "type": "text",
      "id": "primary_cta_text",
      "label": "Primary CTA Text",
      "default": "SHOP SNEAKERS"
    },
    {
      "type": "url",
      "id": "secondary_cta_link",
      "label": "Secondary CTA Link",
      "default": "/collections/accessories"
    },
    {
      "type": "text",
      "id": "secondary_cta_text",
      "label": "Secondary CTA Text",
      "default": "VIEW ACCESSORIES"
    }
  ],
  "presets": [
    {
      "name": "Wardrobe Hero",
      "category": "Wardrobe"
    }
  ]
}
{% endschema %}
