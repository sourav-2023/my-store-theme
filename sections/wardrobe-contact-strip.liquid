{{ 'wardrobe-base.css' | asset_url | stylesheet_tag }}

<div class="wardrobe-contact-strip" id="wardrobe-contact-strip">
  <div class="wardrobe-contact-strip__container">
    <!-- Left Content -->
    <div class="wardrobe-contact-strip__left">
      <div class="wardrobe-contact-strip__label">VISIT THE STORE</div>
      <h2 class="wardrobe-contact-strip__headline">Find us in <span class="wardrobe-contact-strip__accent">Police Bazar</span></h2>
      
      <div class="wardrobe-contact-strip__info">
        <div class="wardrobe-contact-strip__business-name">The Wardrobe Shillong</div>
        <div class="wardrobe-contact-strip__address">{{ section.settings.address }}</div>
      </div>
      
      <div class="wardrobe-contact-strip__details-grid">
        <div class="wardrobe-contact-strip__detail">
          <div class="wardrobe-contact-strip__detail-label">HOURS</div>
          <div class="wardrobe-contact-strip__detail-value">{{ section.settings.hours }}</div>
        </div>
        <div class="wardrobe-contact-strip__detail">
          <div class="wardrobe-contact-strip__detail-label">WHATSAPP</div>
          <div class="wardrobe-contact-strip__detail-value">+91 {{ section.settings.whatsapp }}</div>
        </div>
      </div>
      
      <!-- CTAs -->
      <div class="wardrobe-contact-strip__ctas">
        <a href="https://maps.google.com/?q={{ section.settings.address | url_encode }}" target="_blank" class="wardrobe-button wardrobe-button--gold">
          GET DIRECTIONS
        </a>
        <a href="https://wa.me/91{{ section.settings.whatsapp | replace: ' ', '' }}" target="_blank" class="wardrobe-button wardrobe-button--ghost-gold">
          MESSAGE US
        </a>
      </div>
    </div>
    
    <!-- Right Content -->
    <div class="wardrobe-contact-strip__right">
      <div class="wardrobe-contact-strip__map">
        <iframe 
          src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d1434.1234567890123!2d91.883333!3d25.566667!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x37507e8f34c00001%3A0x1234567890abcdef!2sPolice%20Bazar%2C%20Shillong!5e0!3m2!1sen!2sin!4v1234567890"
          width="100%" 
          height="400" 
          style="border:0; filter: grayscale(20%) contrast(1.1);"
          allowfullscreen="" 
          loading="lazy">
        </iframe>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Contact Strip",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "address",
      "label": "Store Address",
      "default": "Police Bazar, Police Bazar Road, Shillong, Meghalaya 793001"
    },
    {
      "type": "text",
      "id": "hours",
      "label": "Store Hours",
      "default": "Monday-Saturday 11:00 AM - 8:00 PM"
    },
    {
      "type": "text",
      "id": "phone",
      "label": "Phone Number",
      "default": "+91 94361 12345"
    },
    {
      "type": "text",
      "id": "whatsapp",
      "label": "WhatsApp Number",
      "default": "94361 12345"
    }
  ],
  "presets": [
    {
      "name": "Contact Strip",
      "category": "Wardrobe"
    }
  ]
}
{% endschema %}
