{{ 'wardrobe-base.css' | asset_url | stylesheet_tag }}

<style>
  .wh-section {
    background-color: #FAF8F5;
    min-height: 92vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 80px 40px 60px;
    position: relative;
    overflow: hidden;
  }

  /* Top gold accent line */
  .wh-accent-line {
    width: 1px;
    height: 48px;
    background-color: #B8965A;
    margin: 0 auto 48px;
    opacity: 0;
    animation: wh-fade-down 1s cubic-bezier(0.22, 1, 0.36, 1) forwards;
    animation-delay: 0ms;
  }

  .wh-eyebrow {
    font-family: 'Inter', -apple-system, sans-serif;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: #B8965A;
    margin-bottom: 40px;
    opacity: 0;
    animation: wh-fade-up 0.8s cubic-bezier(0.22, 1, 0.36, 1) forwards;
    animation-delay: 150ms;
  }

  /* Hero logo */
  .wh-hero-logo {
    margin-bottom: 32px;
    opacity: 0;
    animation: wh-fade-up 1s cubic-bezier(0.22, 1, 0.36, 1) forwards;
    animation-delay: 250ms;
  }

  .wh-hero-logo img {
    height: 100px;
    width: auto;
    display: block;
    margin: 0 auto;
  }

  .wh-headline {
    margin-bottom: 28px;
    opacity: 0;
    animation: wh-fade-up 0.9s cubic-bezier(0.22, 1, 0.36, 1) forwards;
    animation-delay: 350ms;
  }

  .wh-headline h1 {
    font-family: 'Cormorant Garamond', Georgia, serif !important;
    font-size: clamp(64px, 10vw, 140px);
    font-weight: 300;
    line-height: 0.95;
    color: #1A1A1A;
    letter-spacing: -0.02em;
    margin: 0;
  }

  .wh-subtitle {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: clamp(18px, 2.5vw, 24px);
    font-weight: 300;
    font-style: italic;
    color: #999;
    margin-bottom: 56px;
    letter-spacing: 0.02em;
    opacity: 0;
    animation: wh-fade-up 0.8s cubic-bezier(0.22, 1, 0.36, 1) forwards;
    animation-delay: 500ms;
  }

  .wh-ctas {
    opacity: 0;
    animation: wh-fade-up 0.8s cubic-bezier(0.22, 1, 0.36, 1) forwards;
    animation-delay: 650ms;
  }

  .wh-btn {
    font-family: 'Inter', -apple-system, sans-serif;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    text-decoration: none;
    padding: 18px 48px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background-color: #1A1A1A;
    color: #FFFFFF;
    border: 1px solid #1A1A1A;
    border-radius: 0;
    transition: all 0.3s cubic-bezier(0.22, 1, 0.36, 1);
    min-height: 54px;
  }

  .wh-btn:hover {
    background-color: #333;
    transform: translateY(-1px);
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.15);
  }

  /* Scroll indicator */
  .wh-scroll-hint {
    position: absolute;
    bottom: 32px;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    opacity: 0;
    animation: wh-fade-up 0.7s cubic-bezier(0.22, 1, 0.36, 1) forwards;
    animation-delay: 900ms;
  }

  .wh-scroll-hint__text {
    font-family: 'Inter', -apple-system, sans-serif;
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #B8965A;
  }

  .wh-scroll-hint__line {
    width: 1px;
    height: 28px;
    background: #B8965A;
    animation: wh-pulse-line 2s ease-in-out infinite;
  }

  @keyframes wh-fade-up {
    from { opacity: 0; transform: translateY(20px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  @keyframes wh-fade-down {
    from { opacity: 0; transform: translateY(-12px); }
    to   { opacity: 0.7; transform: translateY(0); }
  }

  @keyframes wh-pulse-line {
    0%, 100% { opacity: 0.4; transform: scaleY(1); }
    50% { opacity: 1; transform: scaleY(1.2); }
  }

  @media (max-width: 1024px) {
    .wh-section {
      min-height: 80vh;
      padding: 60px 24px 48px;
    }
    .wh-hero-logo img { height: 80px; }
    .wh-btn { width: 100%; max-width: 300px; }
    .wh-scroll-hint { display: none; }
  }

  @media (max-width: 600px) {
    .wh-section { min-height: 75vh; padding: 48px 20px 40px; }
    .wh-accent-line { height: 36px; margin-bottom: 32px; }
    .wh-hero-logo img { height: 70px; }
    .wh-eyebrow { margin-bottom: 28px; }
    .wh-subtitle { margin-bottom: 40px; }
  }
</style>

<div class="wh-section" id="wardrobe-hero">
  <div class="wh-accent-line"></div>

  <div class="wh-eyebrow">{{ section.settings.eyebrow_text }}</div>

  <div class="wh-hero-logo">
    <img src="{{ 'wardrobe-logo.png' | asset_url }}" alt="{{ shop.name }}">
  </div>

  <div class="wh-headline">
    <h1>{{ section.settings.title_main }}</h1>
  </div>

  <div class="wh-subtitle">{{ section.settings.subtitle }}</div>

  <div class="wh-ctas">
    <a href="{{ section.settings.primary_link }}" class="wh-btn">
      {{ section.settings.primary_text }}
    </a>
  </div>

  <div class="wh-scroll-hint">
    <span class="wh-scroll-hint__text">Scroll</span>
    <span class="wh-scroll-hint__line"></span>
  </div>
</div>

{% schema %}
{
  "name": "Wardrobe Hero",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow_text",
      "label": "Eyebrow Text",
      "default": "EST. SHILLONG, MEGHALAYA"
    },
    {
      "type": "text",
      "id": "title_main",
      "label": "Title",
      "default": "The Wardrobe Shillong"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Shillong's Premium Fashion Destination"
    },
    {
      "type": "text",
      "id": "primary_link",
      "label": "Button Link",
      "default": "/collections/all"
    },
    {
      "type": "text",
      "id": "primary_text",
      "label": "Button Text",
      "default": "EXPLORE COLLECTION"
    }
  ],
  "presets": [
    {
      "name": "Wardrobe Hero",
      "category": "Wardrobe"
    }
  ]
}
{% endschema %}
