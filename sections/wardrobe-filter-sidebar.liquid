{{ 'wardrobe-base.css' | asset_url | stylesheet_tag }}

<div class="wardrobe-filter-sidebar" id="wardrobe-filter-sidebar">
  <div class="wardrobe-filter-sidebar__container">
    {% if section.settings.show_brand_filter %}
    <div class="wardrobe-filter-sidebar__section">
      <h3 class="wardrobe-filter-sidebar__title">BRAND</h3>
      <div class="wardrobe-filter-sidebar__options">
        <label class="wardrobe-filter-sidebar__option">
          <input type="checkbox" class="wardrobe-filter-sidebar__checkbox" value="nike">
          <span class="wardrobe-filter-sidebar__label">Nike</span>
        </label>
        <label class="wardrobe-filter-sidebar__option">
          <input type="checkbox" class="wardrobe-filter-sidebar__checkbox" value="jordan">
          <span class="wardrobe-filter-sidebar__label">Jordan</span>
        </label>
        <label class="wardrobe-filter-sidebar__option">
          <input type="checkbox" class="wardrobe-filter-sidebar__checkbox" value="adidas">
          <span class="wardrobe-filter-sidebar__label">Adidas</span>
        </label>
      </div>
    </div>
    {% endif %}
    
    {% if section.settings.show_size_filter %}
    <div class="wardrobe-filter-sidebar__section">
      <h3 class="wardrobe-filter-sidebar__title">SIZE</h3>
      <div class="wardrobe-filter-sidebar__options">
        <label class="wardrobe-filter-sidebar__option">
          <input type="checkbox" class="wardrobe-filter-sidebar__checkbox" value="7">
          <span class="wardrobe-filter-sidebar__label">7</span>
        </label>
        <label class="wardrobe-filter-sidebar__option">
          <input type="checkbox" class="wardrobe-filter-sidebar__checkbox" value="8">
          <span class="wardrobe-filter-sidebar__label">8</span>
        </label>
        <label class="wardrobe-filter-sidebar__option">
          <input type="checkbox" class="wardrobe-filter-sidebar__checkbox" value="9">
          <span class="wardrobe-filter-sidebar__label">9</span>
        </label>
        <label class="wardrobe-filter-sidebar__option">
          <input type="checkbox" class="wardrobe-filter-sidebar__checkbox" value="10">
          <span class="wardrobe-filter-sidebar__label">10</span>
        </label>
        <label class="wardrobe-filter-sidebar__option">
          <input type="checkbox" class="wardrobe-filter-sidebar__checkbox" value="11">
          <span class="wardrobe-filter-sidebar__label">11</span>
        </label>
      </div>
    </div>
    {% endif %}
    
    {% if section.settings.show_price_filter %}
    <div class="wardrobe-filter-sidebar__section">
      <h3 class="wardrobe-filter-sidebar__title">PRICE</h3>
      <div class="wardrobe-filter-sidebar__options">
        <label class="wardrobe-filter-sidebar__option">
          <input type="checkbox" class="wardrobe-filter-sidebar__checkbox" value="0-5000">
          <span class="wardrobe-filter-sidebar__label">Under ₹5,000</span>
        </label>
        <label class="wardrobe-filter-sidebar__option">
          <input type="checkbox" class="wardrobe-filter-sidebar__checkbox" value="5000-10000">
          <span class="wardrobe-filter-sidebar__label">₹5,000 - ₹10,000</span>
        </label>
        <label class="wardrobe-filter-sidebar__option">
          <input type="checkbox" class="wardrobe-filter-sidebar__checkbox" value="10000-20000">
          <span class="wardrobe-filter-sidebar__label">₹10,000 - ₹20,000</span>
        </label>
        <label class="wardrobe-filter-sidebar__option">
          <input type="checkbox" class="wardrobe-filter-sidebar__checkbox" value="20000+">
          <span class="wardrobe-filter-sidebar__label">Above ₹20,000</span>
        </label>
      </div>
    </div>
    {% endif %}
    
    {% if section.settings.show_availability_filter %}
    <div class="wardrobe-filter-sidebar__section">
      <h3 class="wardrobe-filter-sidebar__title">AVAILABILITY</h3>
      <div class="wardrobe-filter-sidebar__options">
        <label class="wardrobe-filter-sidebar__option">
          <input type="checkbox" class="wardrobe-filter-sidebar__checkbox" value="in-stock">
          <span class="wardrobe-filter-sidebar__label">In Stock</span>
        </label>
        <label class="wardrobe-filter-sidebar__option">
          <input type="checkbox" class="wardrobe-filter-sidebar__checkbox" value="pre-order">
          <span class="wardrobe-filter-sidebar__label">Pre-Order</span>
        </label>
      </div>
    </div>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Filter Sidebar",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_brand_filter",
      "label": "Show Brand Filter",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_size_filter",
      "label": "Show Size Filter",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_price_filter",
      "label": "Show Price Filter",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_availability_filter",
      "label": "Show Availability Filter",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Filter Sidebar",
      "category": "Wardrobe"
    }
  ]
}
{% endschema %}
