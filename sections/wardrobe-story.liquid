{{ 'wardrobe-base.css' | asset_url | stylesheet_tag }}

<div class="wardrobe-story" id="wardrobe-story">
  <div class="wardrobe-story__container">
    <div class="wardrobe-story__image">
      <div class="wardrobe-story__image-wrapper">
        <img src="{{ 'wardrobe-store.jpg' | asset_url }}" alt="The Wardrobe Shillong Store" class="wardrobe-story__store-photo" onerror="this.style.display='none'">
      </div>
    </div>
    <div class="wardrobe-story__content">
      <div class="wardrobe-story__label-wrapper">
        <span class="wardrobe-story__line"></span>
        <span class="wardrobe-story__label">OUR STORY</span>
        <span class="wardrobe-story__line"></span>
      </div>
      <h2 class="wardrobe-story__title">{{ section.settings.title }}</h2>
      <div class="wardrobe-story__text">
        <p>The Wardrobe was born from a simple belief — that the hills of Meghalaya deserve access to the same quality and curation found in India's fashion capitals. We source from the best — global brands, independent labels, and timeless classics.</p>
        <p>From Police Bazar to your door. Every piece in our collection is hand-selected for quality, fit, and longevity. We believe fashion should be an investment, not just a purchase.</p>
      </div>
      <a href="{{ section.settings.cta_link }}" class="wardrobe-button wardrobe-button--ghost">
        {{ section.settings.cta_text }} →
      </a>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Story Section",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Story Title",
      "default": "Curating Shillong's Finest Since Day One"
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "CTA Button Text",
      "default": "DISCOVER MORE"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "CTA Button Link",
      "default": "/pages/about"
    }
  ],
  "presets": [
    {
      "name": "Story Section",
      "category": "Wardrobe"
    }
  ]
}
{% endschema %}
