{{ 'wardrobe-base.css' | asset_url | stylesheet_tag }}

<style>
  .wh-section {
    background-color: #FFFFFF;
    min-height: 92vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 80px 40px 60px;
    position: relative;
    overflow: hidden;
  }

  /* Subtle decorative corner accents */
  .wh-section::before,
  .wh-section::after {
    content: '';
    position: absolute;
    width: 80px;
    height: 80px;
    border: 1px solid rgba(184, 150, 90, 0.15);
    pointer-events: none;
  }
  .wh-section::before {
    top: 40px;
    left: 40px;
    border-right: none;
    border-bottom: none;
  }
  .wh-section::after {
    bottom: 40px;
    right: 40px;
    border-left: none;
    border-top: none;
  }

  /* Hero logo */
  .wh-hero-logo {
    margin-bottom: 36px;
    opacity: 0;
    animation: wh-fade-up 1s cubic-bezier(0.22, 1, 0.36, 1) forwards;
    animation-delay: 0ms;
  }

  .wh-hero-logo img {
    height: 200px;
    width: auto;
    display: block;
    margin: 0 auto;
  }

  @media (max-width: 1024px) {
    .wh-hero-logo img {
      height: 160px;
    }
  }

  @media (max-width: 600px) {
    .wh-hero-logo img {
      height: 130px;
    }
  }

  /* Decorative vertical rule */
  .wh-rule {
    width: 1px;
    height: 64px;
    background: linear-gradient(to bottom, transparent, #B8965A, transparent);
    margin: 0 auto 36px;
    opacity: 0;
    animation: wh-fade-down 1s cubic-bezier(0.22, 1, 0.36, 1) forwards;
    animation-delay: 100ms;
  }

  .wh-eyebrow {
    font-family: 'Inter', -apple-system, sans-serif;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: #B8965A;
    margin-bottom: 36px;
    opacity: 0;
    animation: wh-fade-up 0.8s cubic-bezier(0.22, 1, 0.36, 1) forwards;
    animation-delay: 200ms;
  }

  .wh-headline {
    margin-bottom: 20px;
  }

  .wh-title-main {
    display: block;
    font-family: 'Cormorant Garamond', Georgia, serif !important;
    font-size: clamp(72px, 9vw, 120px);
    font-weight: 300;
    line-height: 0.92;
    color: #1A1A1A;
    letter-spacing: -0.02em;
    opacity: 0;
    animation: wh-fade-up 0.9s cubic-bezier(0.22, 1, 0.36, 1) forwards;
    animation-delay: 300ms;
  }

  .wh-title-accent {
    display: block;
    font-family: 'Cormorant Garamond', Georgia, serif !important;
    font-size: clamp(72px, 9vw, 120px);
    font-weight: 300;
    font-style: italic;
    line-height: 1.05;
    color: #B8965A;
    letter-spacing: -0.02em;
    opacity: 0;
    animation: wh-fade-up 0.9s cubic-bezier(0.22, 1, 0.36, 1) forwards;
    animation-delay: 420ms;
  }

  .wh-subtitle {
    font-family: 'Inter', -apple-system, sans-serif;
    font-size: 12px;
    font-weight: 400;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #999;
    margin-top: 32px;
    margin-bottom: 52px;
    opacity: 0;
    animation: wh-fade-up 0.8s cubic-bezier(0.22, 1, 0.36, 1) forwards;
    animation-delay: 540ms;
  }

  .wh-ctas {
    display: flex;
    gap: 16px;
    justify-content: center;
    align-items: center;
    flex-wrap: wrap;
    opacity: 0;
    animation: wh-fade-up 0.8s cubic-bezier(0.22, 1, 0.36, 1) forwards;
    animation-delay: 650ms;
  }

  .wh-btn {
    font-family: 'Inter', -apple-system, sans-serif;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    text-decoration: none;
    padding: 16px 36px;
    display: inline-flex;
    align-items: center;
    border-radius: 0;
    transition: all 0.3s cubic-bezier(0.22, 1, 0.36, 1);
    min-height: 50px;
    position: relative;
    overflow: hidden;
  }

  .wh-btn--primary {
    background-color: #1A1A1A;
    color: #FFFFFF;
    border: 1px solid #1A1A1A;
  }

  .wh-btn--primary:hover {
    background-color: #333;
    transform: translateY(-1px);
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.15);
  }

  .wh-btn--ghost {
    background-color: transparent;
    color: #1A1A1A;
    border: 1px solid #1A1A1A;
  }

  .wh-btn--ghost:hover {
    background-color: #1A1A1A;
    color: #FFFFFF;
    transform: translateY(-1px);
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.1);
  }

  /* Scroll indicator */
  .wh-scroll-hint {
    position: absolute;
    bottom: 32px;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    opacity: 0;
    animation: wh-fade-up 0.7s cubic-bezier(0.22, 1, 0.36, 1) forwards;
    animation-delay: 900ms;
  }

  .wh-scroll-hint__text {
    font-family: 'Inter', -apple-system, sans-serif;
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #B8965A;
  }

  .wh-scroll-hint__line {
    width: 1px;
    height: 28px;
    background: #B8965A;
    animation: wh-pulse-line 2s ease-in-out infinite;
  }

  @keyframes wh-fade-up {
    from { opacity: 0; transform: translateY(20px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  @keyframes wh-fade-down {
    from { opacity: 0; transform: translateY(-12px); }
    to   { opacity: 0.7; transform: translateY(0); }
  }

  @keyframes wh-pulse-line {
    0%, 100% { opacity: 0.4; transform: scaleY(1); }
    50% { opacity: 1; transform: scaleY(1.2); }
  }

  @media (max-width: 1024px) {
    .wh-section {
      min-height: 80vh;
      padding: 60px 24px 48px;
    }
    .wh-section::before, .wh-section::after { display: none; }
    .wh-ctas { flex-direction: column; gap: 12px; }
    .wh-btn { width: 100%; max-width: 280px; justify-content: center; }
    .wh-scroll-hint { display: none; }
  }

  @media (max-width: 600px) {
    .wh-section { min-height: 75vh; padding: 48px 20px 40px; }
    .wh-rule { height: 48px; margin-bottom: 24px; }
    .wh-subtitle { margin-top: 20px; margin-bottom: 36px; }
  }
</style>

<div class="wh-section" id="wardrobe-hero">
  <div class="wh-hero-logo">
    <img src="{{ 'wardrobe-logo.png' | asset_url }}" alt="{{ shop.name }}">
  </div>

  <div class="wh-rule"></div>

  <div class="wh-eyebrow">{{ section.settings.eyebrow_text }}</div>

  <div class="wh-headline">
    <h1>
      <span class="wh-title-main">{{ section.settings.title_main }}</span>
      <span class="wh-title-accent">{{ section.settings.title_accent }}</span>
    </h1>
  </div>

  <div class="wh-subtitle">{{ section.settings.subtitle }}</div>

  <div class="wh-ctas">
    <a href="{{ section.settings.primary_link }}" class="wh-btn wh-btn--primary">
      {{ section.settings.primary_text }}
    </a>
    <a href="{{ section.settings.secondary_link }}" class="wh-btn wh-btn--ghost">
      {{ section.settings.secondary_text }}
    </a>
  </div>

  <div class="wh-scroll-hint">
    <span class="wh-scroll-hint__text">Scroll</span>
    <span class="wh-scroll-hint__line"></span>
  </div>
</div>

{% schema %}
{
  "name": "Wardrobe Hero",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow_text",
      "label": "Eyebrow Text",
      "default": "POLICE BAZAR, SHILLONG · EST. 2023"
    },
    {
      "type": "text",
      "id": "title_main",
      "label": "Title — Line 1",
      "default": "Selected"
    },
    {
      "type": "text",
      "id": "title_accent",
      "label": "Title — Line 2 (italic gold)",
      "default": "Acquisitions."
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "POLICE BAZAR, SHILLONG — CURATED RESELLER"
    },
    {
      "type": "text",
      "id": "primary_link",
      "label": "Primary Button Link",
      "default": "/collections/sneakers"
    },
    {
      "type": "text",
      "id": "primary_text",
      "label": "Primary Button Text",
      "default": "SHOP SNEAKERS"
    },
    {
      "type": "text",
      "id": "secondary_link",
      "label": "Secondary Button Link",
      "default": "/collections/accessories"
    },
    {
      "type": "text",
      "id": "secondary_text",
      "label": "Secondary Button Text",
      "default": "VIEW ACCESSORIES"
    }
  ],
  "presets": [
    {
      "name": "Wardrobe Hero",
      "category": "Wardrobe"
    }
  ]
}
{% endschema %}
