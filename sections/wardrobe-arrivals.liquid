{{ 'wardrobe-base.css' | asset_url | stylesheet_tag }}
{{ 'wardrobe-collection.css' | asset_url | stylesheet_tag }}

<style>
  .wa-section {
    background-color: #FAFAFA;
    padding: 100px 40px;
  }

  .wa-container {
    max-width: 1400px;
    margin: 0 auto;
  }

  .wa-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 56px;
    padding-bottom: 28px;
    border-bottom: 1px solid #E0E0E0;
  }

  .wa-heading {
    font-family: 'Cormorant Garamond', Georgia, serif !important;
    font-size: clamp(36px, 4vw, 52px);
    font-weight: 300;
    line-height: 1;
    color: #1A1A1A;
    margin: 0;
  }

  .wa-heading-accent {
    font-style: italic;
    color: #B8965A;
  }

  .wa-meta {
    text-align: right;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 8px;
  }

  .wa-date {
    font-family: 'Inter', -apple-system, sans-serif;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #999;
  }

  .wa-view-all {
    font-family: 'Inter', -apple-system, sans-serif;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #B8965A;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    transition: all 0.3s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .wa-view-all:hover { gap: 10px; color: #1A1A1A; }

  .wa-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 28px;
  }

  /* Scroll-reveal */
  .wa-reveal {
    opacity: 0;
    transform: translateY(30px);
    transition: opacity 0.8s cubic-bezier(0.22, 1, 0.36, 1), transform 0.8s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .wa-reveal.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  .wa-divider {
    height: 1px;
    background-color: #E0E0E0;
    margin: 0;
  }

  @media (max-width: 1024px) {
    .wa-section { padding: 64px 20px; }
    .wa-grid { grid-template-columns: repeat(2, 1fr); gap: 16px; }
    .wa-header { margin-bottom: 36px; }
  }

  @media (max-width: 600px) {
    .wa-grid { grid-template-columns: repeat(2, 1fr); gap: 12px; }
    .wa-heading { font-size: 32px; }
  }
</style>

<div class="wa-section" id="wardrobe-arrivals">
  <div class="wa-container">
    <div class="wa-header wa-reveal">
      <h2 class="wa-heading">
        This Week's <span class="wa-heading-accent">Arrivals</span>
      </h2>
      <div class="wa-meta">
        <span class="wa-date">Week of {{ 'now' | date: '%b %d, %Y' | upcase }}</span>
        <a href="{{ section.settings.view_all_link | default: '/collections/all' }}" class="wa-view-all">
          {{ section.settings.view_all_text | default: 'VIEW ALL' }} →
        </a>
      </div>
    </div>

    <div class="wa-grid wa-reveal">
      {%- assign arrivals_collection = collections[section.settings.featured_collection] -%}
      {%- if arrivals_collection != blank -%}
        {%- for product in arrivals_collection.products limit: section.settings.products_to_show -%}
          {% render 'wardrobe-product-card', product: product %}
        {%- endfor -%}
      {%- else -%}
        {%- for product in collections.all.products limit: section.settings.products_to_show -%}
          {% render 'wardrobe-product-card', product: product %}
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</div>

<div class="wa-divider"></div>

{% schema %}
{
  "name": "Wardrobe Arrivals",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "collection",
      "id": "featured_collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to show",
      "min": 2,
      "max": 8,
      "step": 1,
      "default": 4
    },
    {
      "type": "text",
      "id": "view_all_text",
      "label": "View All Text",
      "default": "VIEW ALL"
    },
    {
      "type": "url",
      "id": "view_all_link",
      "label": "View All Link"
    }
  ],
  "presets": [
    {
      "name": "Wardrobe Arrivals",
      "category": "Wardrobe"
    }
  ]
}
{% endschema %}
