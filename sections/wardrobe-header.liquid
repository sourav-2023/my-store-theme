{{ 'wardrobe-header.css' | asset_url | stylesheet_tag }}

<style>
  /* Wardrobe Custom Header */
  .wh-header-wrapper {
    position: sticky;
    top: 0;
    z-index: 100;
    background-color: #FFFFFF;
    border-bottom: 1px solid #E8E8E8;
  }

  .wh-header {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 40px;
    height: 64px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }

  /* Logo */
  .wh-logo {
    text-decoration: none;
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .wh-logo__desktop {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .wh-logo__mobile {
    display: none;
  }

  .wh-logo__text {
    font-family: 'Cormorant Garamond', Georgia, serif !important;
    font-size: 18px;
    font-weight: 400;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #1A1A1A;
  }

  .wh-logo img {
    height: 32px;
    width: auto;
    display: block;
  }

  .wh-logo:hover {
    opacity: 0.8;
  }

  @media (max-width: 1024px) {
    .wh-logo__desktop {
      display: none;
    }
    .wh-logo__mobile {
      display: flex;
      align-items: center;
    }
    .wh-logo img {
      height: 28px;
    }
  }

  /* Navigation */
  .wh-nav {
    display: flex;
    align-items: center;
    gap: 32px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .wh-nav__item {
    position: relative;
  }

  .wh-nav__link {
    font-family: 'Inter', -apple-system, sans-serif;
    font-size: 13px;
    font-weight: 400;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #1A1A1A;
    text-decoration: none;
    padding: 20px 0;
    display: block;
    transition: color 0.15s ease;
  }

  .wh-nav__link:hover,
  .wh-nav__link--active {
    color: #B8965A;
  }

  /* Dropdown */
  .wh-dropdown {
    position: absolute;
    top: 100%;
    left: 0;
    background: #FFFFFF;
    border: 1px solid #E8E8E8;
    min-width: 200px;
    padding: 16px 0;
    opacity: 0;
    visibility: hidden;
    transform: translateY(-8px);
    transition: all 0.2s ease;
    z-index: 101;
  }

  .wh-nav__item:hover .wh-dropdown {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .wh-dropdown__link {
    font-family: 'Inter', -apple-system, sans-serif;
    font-size: 13px;
    color: #1A1A1A;
    text-decoration: none;
    display: block;
    padding: 10px 24px;
    transition: all 0.15s ease;
  }

  .wh-dropdown__link:hover {
    color: #B8965A;
    background: #FFFFFF;
  }

  /* Icons */
  .wh-icons {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .wh-icon {
    color: #1A1A1A;
    background: none;
    border: none;
    padding: 4px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: color 0.15s ease;
  }

  .wh-icon:hover {
    color: #B8965A;
  }

  .wh-icon svg {
    width: 20px;
    height: 20px;
  }

  /* Cart count bubble */
  .wh-cart {
    position: relative;
  }

  .wh-cart__count {
    position: absolute;
    top: -6px;
    right: -6px;
    background: #1A1A1A;
    color: #FFFFFF;
    font-family: 'Inter', sans-serif;
    font-size: 10px;
    font-weight: 600;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* Mobile menu */
  .wh-mobile-toggle {
    display: none;
    background: none;
    border: none;
    padding: 4px;
    cursor: pointer;
    color: #1A1A1A;
  }

  .wh-mobile-menu {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: #1A1A1A;
    z-index: 200;
    padding: 80px 40px 40px;
  }

  .wh-mobile-menu.is-open {
    display: block;
  }

  .wh-mobile-close {
    position: absolute;
    top: 20px;
    right: 20px;
    background: none;
    border: none;
    color: #FFFFFF;
    cursor: pointer;
    padding: 8px;
  }

  .wh-mobile-nav {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .wh-mobile-nav__item {
    border-bottom: 1px solid rgba(255,255,255,0.1);
  }

  .wh-mobile-nav__link {
    font-family: 'Cormorant Garamond', serif;
    font-size: 32px;
    font-weight: 300;
    color: #FFFFFF;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    text-decoration: none;
    display: block;
    padding: 20px 0;
    transition: color 0.15s ease;
  }

  .wh-mobile-nav__link:hover {
    color: #B8965A;
  }

  .wh-mobile-nav__sub {
    list-style: none;
    padding: 0 0 16px 20px;
    margin: 0;
  }

  .wh-mobile-nav__sub-link {
    font-family: 'Inter', sans-serif;
    font-size: 14px;
    color: rgba(255,255,255,0.7);
    text-decoration: none;
    display: block;
    padding: 10px 0;
  }

  @media (max-width: 1024px) {
    .wh-header {
      padding: 0 20px;
      height: 56px;
    }

    .wh-nav {
      display: none;
    }

    .wh-mobile-toggle {
      display: flex;
    }
  }
</style>

<div class="wh-header-wrapper">
  <header class="wh-header">
    <!-- Mobile Toggle -->
    <button class="wh-mobile-toggle" onclick="document.getElementById('wh-mobile-menu').classList.add('is-open')">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
        <line x1="3" y1="6" x2="21" y2="6"/>
        <line x1="3" y1="12" x2="21" y2="12"/>
        <line x1="3" y1="18" x2="21" y2="18"/>
      </svg>
    </button>

    <!-- Logo -->
    <a href="/" class="wh-logo">
      <!-- Desktop Logo: Logo + Text -->
      <div class="wh-logo__desktop">
        {%- if section.settings.desktop_logo != blank -%}
          <img src="{{ section.settings.desktop_logo | image_url: width: 200 }}" alt="{{ shop.name }}">
        {%- elsif settings.logo != blank -%}
          <img src="{{ settings.logo | image_url: width: 200 }}" alt="{{ shop.name }}">
        {%- endif -%}
        <span class="wh-logo__text">THE WARDROBE</span>
      </div>
      <!-- Mobile Logo: Logo Only (with text fallback) -->
      <div class="wh-logo__mobile">
        {%- if section.settings.mobile_logo != blank -%}
          <img src="{{ section.settings.mobile_logo | image_url: width: 200 }}" alt="{{ shop.name }}">
        {%- elsif section.settings.desktop_logo != blank -%}
          <img src="{{ section.settings.desktop_logo | image_url: width: 200 }}" alt="{{ shop.name }}">
        {%- elsif settings.logo != blank -%}
          <img src="{{ settings.logo | image_url: width: 200 }}" alt="{{ shop.name }}">
        {%- else -%}
          <span class="wh-logo__text">THE WARDROBE</span>
        {%- endif -%}
      </div>
    </a>

    <!-- Desktop Navigation -->
    <nav>
      <ul class="wh-nav">
        <li class="wh-nav__item">
          <a href="/" class="wh-nav__link{% if request.path == '/' %} wh-nav__link--active{% endif %}">Home</a>
        </li>
        <li class="wh-nav__item">
          <a href="/collections/sneakers" class="wh-nav__link{% if request.path contains '/collections/sneakers' %} wh-nav__link--active{% endif %}">Sneakers</a>
        </li>
        <li class="wh-nav__item">
          <a href="/collections/clothing" class="wh-nav__link{% if request.path contains '/collections/clothing' %} wh-nav__link--active{% endif %}">Clothing</a>
        </li>
        <li class="wh-nav__item">
          <a href="/collections/accessories" class="wh-nav__link{% if request.path contains '/collections/accessories' %} wh-nav__link--active{% endif %}">Accessories</a>
          <div class="wh-dropdown">
            <a href="/collections/accessories#watches" class="wh-dropdown__link" onclick="sessionStorage.setItem('accessoryFilter', 'watches')">Watches</a>
            <a href="/collections/accessories#bags" class="wh-dropdown__link" onclick="sessionStorage.setItem('accessoryFilter', 'bags')">Purses & Bags</a>
            <a href="/collections/accessories#perfumes" class="wh-dropdown__link" onclick="sessionStorage.setItem('accessoryFilter', 'perfumes')">Perfumes</a>
            <a href="/collections/accessories#jewelry" class="wh-dropdown__link" onclick="sessionStorage.setItem('accessoryFilter', 'jewelry')">Earrings & Jewelry</a>
            <a href="/collections/accessories#belts" class="wh-dropdown__link" onclick="sessionStorage.setItem('accessoryFilter', 'belts')">Belts</a>
            <a href="/collections/accessories#sunglasses" class="wh-dropdown__link" onclick="sessionStorage.setItem('accessoryFilter', 'sunglasses')">Sunglasses</a>
          </div>
        </li>
        <li class="wh-nav__item">
          <a href="/pages/about" class="wh-nav__link{% if request.path contains '/pages/about' %} wh-nav__link--active{% endif %}">About</a>
        </li>
      </ul>
    </nav>

    <!-- Icons -->
    <div class="wh-icons">
      <a href="/search" class="wh-icon" aria-label="Search">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <circle cx="11" cy="11" r="8"/>
          <line x1="21" y1="21" x2="16.65" y2="16.65"/>
        </svg>
      </a>
      <a href="/account" class="wh-icon" aria-label="Account">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
          <circle cx="12" cy="7" r="4"/>
        </svg>
      </a>
      <a href="/cart" class="wh-icon wh-cart" aria-label="Cart">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <circle cx="9" cy="21" r="1"/>
          <circle cx="20" cy="21" r="1"/>
          <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/>
        </svg>
        {%- if cart.item_count > 0 -%}
          <span class="wh-cart__count">{{ cart.item_count }}</span>
        {%- endif -%}
      </a>
    </div>
  </header>
</div>

<!-- Mobile Menu -->
<div class="wh-mobile-menu" id="wh-mobile-menu">
  <button class="wh-mobile-close" onclick="this.parentElement.classList.remove('is-open')">
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
      <line x1="18" y1="6" x2="6" y2="18"/>
      <line x1="6" y1="6" x2="18" y2="18"/>
    </svg>
  </button>

  <ul class="wh-mobile-nav">
    <li class="wh-mobile-nav__item">
      <a href="/" class="wh-mobile-nav__link">Home</a>
    </li>
    <li class="wh-mobile-nav__item">
      <a href="/collections/sneakers" class="wh-mobile-nav__link">Sneakers</a>
    </li>
    <li class="wh-mobile-nav__item">
      <a href="/collections/clothing" class="wh-mobile-nav__link">Clothing</a>
    </li>
    <li class="wh-mobile-nav__item">
      <a href="/collections/accessories" class="wh-mobile-nav__link">Accessories</a>
      <ul class="wh-mobile-nav__sub">
        <li><a href="/collections/accessories#watches" class="wh-mobile-nav__sub-link" onclick="sessionStorage.setItem('accessoryFilter', 'watches')">Watches</a></li>
        <li><a href="/collections/accessories#bags" class="wh-mobile-nav__sub-link" onclick="sessionStorage.setItem('accessoryFilter', 'bags')">Purses & Bags</a></li>
        <li><a href="/collections/accessories#perfumes" class="wh-mobile-nav__sub-link" onclick="sessionStorage.setItem('accessoryFilter', 'perfumes')">Perfumes</a></li>
        <li><a href="/collections/accessories#jewelry" class="wh-mobile-nav__sub-link" onclick="sessionStorage.setItem('accessoryFilter', 'jewelry')">Earrings & Jewelry</a></li>
        <li><a href="/collections/accessories#belts" class="wh-mobile-nav__sub-link" onclick="sessionStorage.setItem('accessoryFilter', 'belts')">Belts</a></li>
        <li><a href="/collections/accessories#sunglasses" class="wh-mobile-nav__sub-link" onclick="sessionStorage.setItem('accessoryFilter', 'sunglasses')">Sunglasses</a></li>
      </ul>
    </li>
    <li class="wh-mobile-nav__item">
      <a href="/pages/about" class="wh-mobile-nav__link">About</a>
    </li>
    <li class="wh-mobile-nav__item">
      <a href="/account" class="wh-mobile-nav__link">Account</a>
    </li>
  </ul>
</div>

{% schema %}
{
  "name": "Wardrobe Header",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "desktop_logo",
      "label": "Desktop Logo",
      "info": "Logo for desktop view (shown with 'THE WARDROBE' text)"
    },
    {
      "type": "image_picker",
      "id": "mobile_logo",
      "label": "Mobile Logo",
      "info": "Logo for mobile view (shown without text)"
    }
  ],
  "presets": [
    {
      "name": "Wardrobe Header",
      "category": "Wardrobe"
    }
  ]
}
{% endschema %}
