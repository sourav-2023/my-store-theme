{{ 'wardrobe-base.css' | asset_url | stylesheet_tag }}

<style>
  .wardrobe-categories {
    background-color: #F5F0E8;
    padding: 60px 0;
  }
  .wardrobe-categories__container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 40px;
  }
  .wardrobe-categories__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }
  .wardrobe-categories__card {
    position: relative;
    display: block;
    text-decoration: none;
    overflow: hidden;
  }
  .wardrobe-categories__image {
    aspect-ratio: 3/4;
    overflow: hidden;
    background: #1A1A1A;
  }
  .wardrobe-categories__image-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, #2a2a2a 0%, #1A1A1A 100%);
  }
  .wardrobe-categories__category-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .wardrobe-categories__overlay {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 40px 24px;
    background: linear-gradient(to top, rgba(0,0,0,0.7) 0%, transparent 100%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
  }
  .wardrobe-categories__title {
    font-family: 'Cormorant Garamond', Georgia, serif !important;
    font-size: 24px;
    font-weight: 300;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: #FFFFFF;
    margin: 0;
  }
  .wardrobe-categories__cta {
    font-family: 'Inter', -apple-system, sans-serif;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #B8965A;
  }
  .wardrobe-categories__header {
    text-align: center;
    margin-bottom: 40px;
  }
  .wardrobe-categories__heading {
    font-family: 'Cormorant Garamond', Georgia, serif !important;
    font-size: 36px;
    font-weight: 300;
    color: #1A1A1A;
    margin: 0;
  }
  
  @media (max-width: 1024px) {
    .wardrobe-categories__header { margin-bottom: 24px; }
    .wardrobe-categories__heading { font-size: 28px; }
    .wardrobe-categories { padding: 40px 0; }
    .wardrobe-categories__container { padding: 0 16px; }
    .wardrobe-categories__grid { 
      grid-template-columns: 1fr; 
      gap: 16px; 
    }
    .wardrobe-categories__image { aspect-ratio: 16/10; }
    .wardrobe-categories__overlay { padding: 24px 16px; }
    .wardrobe-categories__title { font-size: 20px; letter-spacing: 0.1em; }
  }
</style>

<div class="wardrobe-categories" id="wardrobe-categories">
  <div class="wardrobe-categories__container">
    <div class="wardrobe-categories__header">
      <h2 class="wardrobe-categories__heading">Shop by Category</h2>
    </div>
    <div class="wardrobe-categories__grid">
      <a href="/collections/sneakers" class="wardrobe-categories__card">
        <div class="wardrobe-categories__image">
          <div class="wardrobe-categories__image-placeholder">
            <img src="{{ 'wardrobe-category-sneakers.png' | asset_url }}" alt="Sneakers" class="wardrobe-categories__category-img" loading="lazy" onerror="this.style.display='none'">
          </div>
        </div>
        <div class="wardrobe-categories__overlay">
          <h3 class="wardrobe-categories__title">SNEAKERS</h3>
          <span class="wardrobe-categories__cta">SHOP →</span>
        </div>
      </a>
      
      <a href="/collections/clothing" class="wardrobe-categories__card">
        <div class="wardrobe-categories__image">
          <div class="wardrobe-categories__image-placeholder">
            <img src="{{ 'wardrobe-category-clothing.png' | asset_url }}" alt="Clothing" class="wardrobe-categories__category-img" loading="lazy" onerror="this.style.display='none'">
          </div>
        </div>
        <div class="wardrobe-categories__overlay">
          <h3 class="wardrobe-categories__title">CLOTHING</h3>
          <span class="wardrobe-categories__cta">SHOP →</span>
        </div>
      </a>
      
      <a href="/collections/accessories" class="wardrobe-categories__card">
        <div class="wardrobe-categories__image">
          <div class="wardrobe-categories__image-placeholder">
            <img src="{{ 'wardrobe-category-accessories.avif' | asset_url }}" alt="Accessories" class="wardrobe-categories__category-img" loading="lazy" onerror="this.style.display='none'">
          </div>
        </div>
        <div class="wardrobe-categories__overlay">
          <h3 class="wardrobe-categories__title">ACCESSORIES</h3>
          <span class="wardrobe-categories__cta">SHOP →</span>
        </div>
      </a>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Categories Section",
  "tag": "section",
  "class": "section",
  "settings": [],
  "presets": [
    {
      "name": "Categories Section",
      "category": "Wardrobe"
    }
  ]
}
{% endschema %}
