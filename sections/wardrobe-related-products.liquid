{{ 'wardrobe-base.css' | asset_url | stylesheet_tag }}
{{ 'wardrobe-collection.css' | asset_url | stylesheet_tag }}

<style>
  .wrp-section {
    background-color: #FFFFFF;
    padding: 80px 40px;
  }

  .wrp-container {
    max-width: 1400px;
    margin: 0 auto;
  }

  .wrp-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 40px;
    padding-bottom: 24px;
    border-bottom: 1px solid #E8E8E8;
  }

  .wrp-title {
    font-family: 'Cormorant Garamond', Georgia, serif !important;
    font-size: 32px;
    font-weight: 300;
    color: #1A1A1A;
    margin: 0;
  }

  .wrp-link {
    font-family: 'Inter', -apple-system, sans-serif;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #1A1A1A;
    text-decoration: none;
    border-bottom: 1px solid #1A1A1A;
    padding-bottom: 2px;
    transition: color 0.15s ease, border-color 0.15s ease;
  }

  .wrp-link:hover {
    color: #B8965A;
    border-color: #B8965A;
  }

  .wrp-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
  }

  @media (max-width: 1024px) {
    .wrp-section {
      padding: 60px 20px;
    }

    .wrp-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 16px;
    }

    .wrp-title {
      font-size: 24px;
    }
  }
</style>

{%- liquid
  assign current_product = product
  assign related_products = current_product.collections[0].products | where_not: 'id', current_product.id | limit: section.settings.products_to_show
-%}

{%- if related_products.size > 0 -%}
  <div class="wrp-section">
    <div class="wrp-container">
      <div class="wrp-header">
        <h2 class="wrp-title">{{ section.settings.heading }}</h2>
        {%- if section.settings.show_view_all -%}
          <a href="{{ current_product.collections[0].url }}" class="wrp-link">{{ section.settings.view_all_text }}</a>
        {%- endif -%}
      </div>

      <div class="wrp-grid">
        {%- for related_product in related_products -%}
          {%- render 'wardrobe-product-card', product: related_product -%}
        {%- endfor -%}
      </div>
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Related Products",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "You may also like"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to show",
      "min": 2,
      "max": 8,
      "step": 2,
      "default": 4
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show 'View all' link",
      "default": true
    },
    {
      "type": "text",
      "id": "view_all_text",
      "label": "View all text",
      "default": "View All"
    }
  ],
  "presets": [
    {
      "name": "Related Products",
      "category": "Wardrobe"
    }
  ]
}
{% endschema %}
