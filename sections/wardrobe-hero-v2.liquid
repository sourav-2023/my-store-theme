{{ 'wardrobe-base.css' | asset_url | stylesheet_tag }}

<style>
  @import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;1,300;1,400&display=swap');

  .wh-section {
    background-color: #FFFFFF;
    min-height: 92vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 80px 40px 60px;
    position: relative;
    overflow: hidden;
  }

  /* Decorative vertical rule — matches design reference */
  .wh-rule {
    width: 1px;
    height: 64px;
    background-color: #B8965A;
    margin: 0 auto 32px;
    opacity: 0;
    animation: wh-fade-down 0.8s ease forwards;
    animation-delay: 0ms;
  }

  .wh-eyebrow {
    font-family: 'Inter', -apple-system, sans-serif;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #B8965A;
    margin-bottom: 32px;
    opacity: 0;
    animation: wh-fade-up 0.7s ease forwards;
    animation-delay: 120ms;
  }

  .wh-headline {
    margin-bottom: 20px;
  }

  .wh-title-main {
    display: block;
    font-family: 'Cormorant Garamond', Georgia, serif !important;
    font-size: clamp(72px, 9vw, 112px);
    font-weight: 300;
    line-height: 0.95;
    color: #1A1A1A;
    letter-spacing: -0.01em;
    opacity: 0;
    animation: wh-fade-up 0.8s ease forwards;
    animation-delay: 220ms;
  }

  .wh-title-accent {
    display: block;
    font-family: 'Cormorant Garamond', Georgia, serif !important;
    font-size: clamp(72px, 9vw, 112px);
    font-weight: 300;
    font-style: italic;
    line-height: 1.05;
    color: #B8965A;
    letter-spacing: -0.01em;
    opacity: 0;
    animation: wh-fade-up 0.8s ease forwards;
    animation-delay: 340ms;
  }

  .wh-subtitle {
    font-family: 'Inter', -apple-system, sans-serif;
    font-size: 12px;
    font-weight: 400;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #6B7280;
    margin-top: 28px;
    margin-bottom: 48px;
    opacity: 0;
    animation: wh-fade-up 0.7s ease forwards;
    animation-delay: 460ms;
  }

  .wh-ctas {
    display: flex;
    gap: 16px;
    justify-content: center;
    align-items: center;
    flex-wrap: wrap;
    opacity: 0;
    animation: wh-fade-up 0.7s ease forwards;
    animation-delay: 560ms;
  }

  .wh-btn {
    font-family: 'Inter', -apple-system, sans-serif;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-decoration: none;
    padding: 14px 32px;
    display: inline-flex;
    align-items: center;
    border-radius: 0;
    transition: background-color 0.15s ease, color 0.15s ease;
    min-height: 48px;
  }

  .wh-btn--primary {
    background-color: #1A1A1A;
    color: #FFFFFF;
    border: 1px solid #1A1A1A;
  }

  .wh-btn--primary:hover {
    background-color: #FFFFFF;
    color: #1A1A1A;
  }

  .wh-btn--ghost {
    background-color: transparent;
    color: #1A1A1A;
    border: 1px solid #1A1A1A;
  }

  .wh-btn--ghost:hover {
    background-color: #1A1A1A;
    color: #FFFFFF;
  }

  .wh-divider {
    height: 1px;
    background-color: #E8E8E8;
    margin: 0;
  }

  @keyframes wh-fade-up {
    from { opacity: 0; transform: translateY(16px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  @keyframes wh-fade-down {
    from { opacity: 0; transform: translateY(-12px); }
    to   { opacity: 0.7; transform: translateY(0); }
  }

  @media (max-width: 1024px) {
    .wh-section {
      min-height: 80vh;
      padding: 60px 24px 48px;
    }
    .wh-ctas { flex-direction: column; gap: 12px; }
    .wh-btn { width: 100%; max-width: 280px; justify-content: center; }
  }

  @media (max-width: 600px) {
    .wh-section { min-height: 75vh; padding: 48px 20px 40px; }
    .wh-rule { height: 48px; margin-bottom: 24px; }
    .wh-subtitle { margin-top: 20px; margin-bottom: 36px; }
  }
</style>

<div class="wh-section" id="wardrobe-hero">
  <div class="wh-rule"></div>

  <img
    src="{{ 'wardrobe-logo-full.png' | asset_url }}"
    alt="{{ shop.name }}"
    style="height:110px;width:auto;display:block;margin:0 auto 28px;"
  >

  <div class="wh-eyebrow">{{ section.settings.eyebrow_text }}</div>

  <div class="wh-headline">
    <h1>
      <span class="wh-title-main">{{ section.settings.title_main }}</span>
      <span class="wh-title-accent">{{ section.settings.title_accent }}</span>
    </h1>
  </div>

  <div class="wh-subtitle">{{ section.settings.subtitle }}</div>

  <div class="wh-ctas">
    <a href="{{ section.settings.primary_link }}" class="wh-btn wh-btn--primary">
      {{ section.settings.primary_text }}
    </a>
    <a href="{{ section.settings.secondary_link }}" class="wh-btn wh-btn--ghost">
      {{ section.settings.secondary_text }}
    </a>
  </div>
</div>

<div class="wh-divider"></div>

{% schema %}
{
  "name": "Wardrobe Hero",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow_text",
      "label": "Eyebrow Text",
      "default": "POLICE BAZAR, SHILLONG · EST. 2023"
    },
    {
      "type": "text",
      "id": "title_main",
      "label": "Title — Line 1",
      "default": "Selected"
    },
    {
      "type": "text",
      "id": "title_accent",
      "label": "Title — Line 2 (italic gold)",
      "default": "Acquisitions."
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "POLICE BAZAR, SHILLONG — CURATED RESELLER"
    },
    {
      "type": "text",
      "id": "primary_link",
      "label": "Primary Button Link",
      "default": "/collections/sneakers"
    },
    {
      "type": "text",
      "id": "primary_text",
      "label": "Primary Button Text",
      "default": "SHOP SNEAKERS"
    },
    {
      "type": "text",
      "id": "secondary_link",
      "label": "Secondary Button Link",
      "default": "/collections/accessories"
    },
    {
      "type": "text",
      "id": "secondary_text",
      "label": "Secondary Button Text",
      "default": "VIEW ACCESSORIES"
    }
  ],
  "presets": [
    {
      "name": "Wardrobe Hero",
      "category": "Wardrobe"
    }
  ]
}
{% endschema %}
